{
  "name": "omp-orca-dispatch",
  "version": "0.1.0",
  "description": "Portable Pi and Oh My Pi extension for safe parallel Orca worktree dispatch",
  "type": "module",
  "license": "Apache-2.0",
  "author": "chen-qianyu",
  "sideEffects": false,
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "ssh://sc-gitea@git.xart.top:52259/chen-qianyu/omp-orca-dispatch.git"
  },
  "homepage": "https://2233admin.github.io/omp-orca-dispatch/",
  "bugs": {
    "url": "https://git.xart.top/chen-qianyu/omp-orca-dispatch/issues"
  },
  "keywords": [
    "pi-package",
    "oh-my-pi",
    "orca",
    "worktree",
    "multi-agent"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "ompOrcaDispatch": {
    "orca": ">=1.4.195",
    "platforms": [
      "Windows",
      "Linux",
      "macOS"
    ]
  },
  "bin": {
    "orca-task-dispatch": "./bin/orca-task-dispatch.mjs"
  },
  "files": [
    "bin",
    "dist",
    "docs",
    "extensions",
    "src",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./pi": {
      "types": "./dist/extensions/pi.d.ts",
      "import": "./dist/extensions/pi.js"
    },
    "./omp": {
      "types": "./dist/extensions/omp.d.ts",
      "import": "./dist/extensions/omp.js"
    }
  },
  "pi": {
    "extensions": [
      "./extensions/pi.ts"
    ]
  },
  "omp": {
    "extensions": [
      "./extensions/omp.ts"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:coverage": "node --import tsx --test --experimental-test-coverage tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "package:dry-run": "npm pack --dry-run",
    "prepack": "npm run check && npm run build",
    "site:dev": "vite --config site/vite.config.ts",
    "site:typecheck": "tsc -p site/tsconfig.json --noEmit",
    "site:build": "vite build --config site/vite.config.ts",
    "site:preview": "vite preview --config site/vite.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/ibm-plex-mono": "npm:@fontsource/ibm-plex-mono@^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/themes": "^3.3.0",
    "i18next": "^26.4.2",
    "motion": "^13.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.13",
    "typebox": "1.3.7"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.4",
    "@oh-my-pi/pi-coding-agent": ">=18.1.8"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.2.2"
  }
}
