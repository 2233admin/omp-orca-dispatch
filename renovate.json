{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "labels": ["type/dependencies", "automation/renovate"],
  "rangeStrategy": "replace",
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "description": "Group non-major development dependency updates",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "development dependencies"
    },
    {
      "description": "Keep host compatibility updates explicit",
      "matchPackageNames": [
        "@earendil-works/pi-coding-agent",
        "@oh-my-pi/pi-coding-agent"
      ],
      "groupName": "host compatibility",
      "automerge": false
    },
    {
      "description": "Never automerge major updates",
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}
